# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Required — the model.
ANTHROPIC_API_KEY=

# Optional — enables web_search, fetch_page, search_reddit, and Product Hunt
# discovery. Without it the run uses HN + GitHub only.
TAVILY_API_KEY=

# Optional — enables search_product_hunt (no-expiry developer token from the
# Product Hunt API dashboard).
PRODUCTHUNT_API_TOKEN=

# Optional — search_github runs keyless at a lower rate limit; a personal
# access token (no scopes needed for public search) just raises that limit.
GITHUB_TOKEN=
