# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Required — the model.
ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace (Console > Workspaces > ID).
ANTHROPIC_WORKSPACE_ID=

# Optional — model override (default claude-sonnet-5). Any other model also
# needs its four prices in $ per million tokens, so the run cost stays right.
# Models that reject a forced tool_choice (claude-opus-5-5, claude-sonnet-5-5,
# claude-fable-5-1) are not supported yet.
BLINDSPOT_MODEL=
BLINDSPOT_PRICE_IN=
BLINDSPOT_PRICE_CACHE_WRITE=
BLINDSPOT_PRICE_CACHE_READ=
BLINDSPOT_PRICE_OUT=

# Optional — enables web_search, fetch_page, search_reddit, and Product Hunt
# discovery. Without it the run uses HN + GitHub only.
TAVILY_API_KEY=

# Optional — enables search_product_hunt (no-expiry developer token from the
# Product Hunt API dashboard).
PRODUCTHUNT_API_TOKEN=

# Optional — search_github runs keyless at a lower rate limit; a personal
# access token (no scopes needed for public search) just raises that limit.
GITHUB_TOKEN=

# Optional spend gate for the web UI. Leave BLANK for local dev (app is open).
# SET IT before exposing a public URL: when present, every /run demands this
# password so an open endpoint can't spend your money. The CLI ignores it.
APP_PASSWORD=

# Optional — port for the web UI (default 3000; Railway sets this itself).
PORT=
